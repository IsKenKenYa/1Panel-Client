#!/usr/bin/expect -f
# ArkUI-X Skill CI 辅助：ace create 的 PTY 包装（绕过 readline 管道崩溃限制）
# 用法: expect scripts/ace-ci-create.exp <输出目录> [ace命令路径] [期望SDK版本]
#   输出目录名仅限字母/数字/下划线（ace 工具约束）
#   期望SDK版本默认 26.0.0（Compile SDK 菜单编号 16）
# 依赖: expect（Linux/macOS 常见预装；macOS 自带）
#
# 实测结论：
# - Compile SDK 为 prompts input 文本提示（ace 工具 CLI 交互实证：type:"input"，validate 接受 "1".."16"）
# - 渲染重绘帧会冲掉 stdin 未读字符，逐字符/方向键/固定 sleep 均无法确定性同步
#   （方向键整串被吞致空提交串位 → 静默 compileSdk=10；逐字符次键可被重绘 flush 吞掉）
# - 本脚本策略：settle 后整串送 "16\r"（实测成功形态，单次成功率最高）；
#   create 后强制落盘校验 compileSdkVersion，不符即清理产物目录并非零退出——
#   宁可显式失败重跑，绝不让错版脚手架静默流出（部分字符被接受会落 SDK 10/15，校验兜底捕获）。

set timeout 120
set outDir [lindex $argv 0]
set aceCmd [lindex $argv 1]
if {$aceCmd == ""} { set aceCmd "ace" }
set expectSdk [lindex $argv 2]
if {$expectSdk == ""} { set expectSdk "26.0.0" }

spawn $aceCmd create $outDir -t app

expect {
    -re {project name} { sleep 1; send "\r"; exp_continue }
    -re {bundleName}   { sleep 1; send "\r"; exp_continue }
    -re {runtimeOS}    { sleep 1; send "1\r"; exp_continue }
    -re {SDk|SDK}      { sleep 2; send "16\r"; exp_continue }
    -re {platform}     { sleep 1; send "1\r"; exp_continue }
    -re {Framework}    { sleep 1; send "2\r"; exp_continue }
    -re {already exists.*repair} { sleep 0.3; send "n\r"; exp_continue }
    timeout { puts "TIMEOUT: ace create 未完成"; exit 1 }
    eof
}

catch wait result
set aceExit [lindex $result 3]
if {$aceExit != 0} { exit $aceExit }

#  落盘校验兜底：送键策略失效也不允许错版脚手架静默流出
set bp [file join $outDir build-profile.json5]
if {![file exists $bp]} {
    puts "ERROR: ace create 退出码 0 但未产出 build-profile.json5"
    exit 1
}
set fp [open $bp r]
set content [read $fp]
close $fp
if {![regexp {compileSdkVersion[^0-9]*([0-9.]+)} $content -> sdkVer]} {
    puts "ERROR: build-profile.json5 未解析出 compileSdkVersion"
    file delete -force $outDir
    exit 1
}
if {$sdkVer != $expectSdk} {
    puts "ERROR: compileSdkVersion=$sdkVer 与期望 $expectSdk 不符（交互应答串位），已清理产物目录，请重跑"
    file delete -force $outDir
    exit 1
}
puts "OK: compileSdkVersion=$sdkVer"
exit 0
