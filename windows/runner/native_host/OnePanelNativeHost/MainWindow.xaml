<Window
    x:Class="OnePanelNativeHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="1Panel Client">

    <!-- Window-level shortcuts: F5 refreshes the hosted page, Ctrl+1..8 selects the Nth nav item. -->
    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="OnNavIndexAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <!-- Caption-height row (48px): client-drawn title bar / drag region. -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar drawn into the client area; system caption buttons overlay its right edge. -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="1Panel Client"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </Grid>

        <NavigationView x:Name="RootNavigationView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <!-- Workspace groups aligned with the 1Panel web sidebar semantics
                     (dashboard is the first entry, mirroring the web home page). -->
                <NavigationViewItem Tag="Dashboard" Content="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="ScriptLibrary" Content="ScriptLibrary">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="Servers" Content="Servers" Icon="Globe" />
                <NavigationViewItem Tag="Files" Content="Files" Icon="Folder" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="Containers" Content="Containers" Icon="AllApps" />
                <!-- EF90 verified against the official Segoe Fluent Icons table and
                     rendered from the local font: it is "Flow" (connected nodes), the
                     closest glyph for container orchestration (multiple containers
                     scheduled as one connected unit). Suggestions checked and rejected:
                     E9A9 is actually "PasswordKeyHide" (a hidden-key glyph; the real
                     "DeveloperTools" is EC7A, a wrench+screwdriver that collides with
                     Toolbox's E90F) and E756 is "CommandPrompt", a terminal glyph
                     already rejected for Commands. Also rendered and rejected:
                     E9F3 "Process" is a dashed circular arrow (reads as in-progress),
                     EEA3 "VirtualMachineGroup" reads as grouped machines colliding
                     with the multi-host Servers semantics. -->
                <NavigationViewItem Tag="Orchestration" Content="Orchestration">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEF90;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Apps" Content="Apps" Icon="Library" />
                <NavigationViewItem Tag="Websites" Content="Websites" Icon="World" />
                <!-- E968 verified against the official Segoe Fluent Icons table: it is
                     "Network" (connected nodes), the closest web-server/infrastructure glyph
                     for OpenResty as the reverse-proxy foundation of Websites. Also checked
                     and rejected: E946 is actually "Info" (not a server glyph), E774 "Globe"
                     / E909 "World" visually collide with Websites' globe icon, and EB41
                     "Website" semantically duplicates the Websites entry; the font has no
                     literal "Server" glyph. -->
                <NavigationViewItem Tag="OpenResty" Content="OpenResty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- HardDrive (EDA2) is the closest Segoe Fluent Icons glyph for databases;
                     E8B7 is actually "Folder" and E7F4 is "TVMonitor", so neither fits. -->
                <NavigationViewItem Tag="Databases" Content="Databases">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- E823 verified against the official Segoe Fluent Icons table: it is "Recent"
                     (clock face with counter-clockwise arrow), the closest clock/schedule glyph
                     for cron jobs; Calendar is actually E787 and pure Clock is E917, so E823's
                     clock-dial semantics best matches periodic scheduled tasks. -->
                <NavigationViewItem Tag="CronJobs" Content="CronJobs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- E777 verified against the official Segoe Fluent Icons table: it is
                     "UpdateRestore", the only glyph carrying restore/point-in-time-recovery
                     semantics, the closest match for backups (no glyph is literally named
                     "Backup" or "Archive"). Alternatives rejected: E8B7 is "Folder" and
                     already taken by Files; E753 is "Cloud" (Sync is actually E895, a
                     directional file-sync glyph); E81C "History" is a clock that visually
                     collides with CronJobs' E823 "Recent". -->
                <NavigationViewItem Tag="Backups" Content="Backups">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- E7F8 verified against the official Segoe Fluent Icons table: it is
                     "DeviceLaptopNoPic", the laptop/host-machine device glyph and the
                     closest match for a host ("System" is actually E770, "Component"
                     E950 reads as a hardware part, "TVMonitor" E7F4 is a plain screen). -->
                <NavigationViewItem Tag="Host" Content="Host">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- E90F verified against the official Segoe Fluent Icons table: it is
                     "Repair" (wrench), the closest tool/maintenance glyph for Toolbox. -->
                <NavigationViewItem Tag="Toolbox" Content="Toolbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Monitoring" Content="Monitoring">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="AI" Content="AI" Icon="PreviewLink" />
                <!-- E945 verified against the official Segoe Fluent Icons table: it is
                     "LightningBolt", matching the quick-command/one-shot execution
                     semantics of the command library, which sits in the AI/automation
                     neighborhood. Also checked and rejected: E756 is actually
                     "CommandPrompt" (an interactive terminal glyph, not a command
                     library — "Switch" is actually E8AB) and would read as a terminal
                     entry; E943 "Code" is a plain source-code glyph. -->
                <NavigationViewItem Tag="Commands" Content="Commands">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- E943 verified against the official Segoe Fluent Icons table: it is
                     "Code" (angle-bracket source-code glyph), the closest semantic match
                     for the script library, which sits in the Commands/automation
                     neighborhood. The font has no literal "Script" glyph; nearby and
                     related candidates were rejected: E944 is "ReturnToWindow" and E946
                     is "Info" (not code glyphs), E756 "CommandPrompt" is an interactive
                     terminal already rejected for Commands, and E945 "LightningBolt" /
                     E9D9 "Diagnostic" are taken by Commands and Logs. -->
                <!-- E9D9 verified against the official Segoe Fluent Icons table: it is
                     "Diagnostic", matching the log-review semantics of the 1Panel web
                     "日志" group (system/operation/login/website logs). E7C3 was also
                     verified ("Page") but is a plain document glyph with no log meaning. -->
                <NavigationViewItem Tag="Logs" Content="Logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Security" Content="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- EA18 verified against the official Segoe Fluent Icons table and
                     rendered from the local font: it is "Shield", the protection/
                     policy-enforcement glyph closest to a security gateway. Checked
                     and rejected: E72E is "Lock" and already used by Security;
                     F5B4 "ShieldLock" embeds a padlock and visually collides with
                     Security; EB77 is literally "GatewayRouter" but renders as a
                     router with signal waves (network hardware, colliding with the
                     network infrastructure glyphs); E8D7 is actually "Permissions"
                     (a key glyph, credentials semantics), not a privacy/gateway
                     glyph as its position in the table might suggest. -->
                <NavigationViewItem Tag="Gateway" Content="Gateway">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- Bottom standalone group. -->
                <NavigationViewItem Tag="Settings" Content="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="16,4,8,12" Spacing="2">
                    <TextBlock Text="1Panel Client"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="WinUI3 Native"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <!-- Shell owns the 8px breathing space around the Mica card
                 (ModulePageBase carries no margin of its own to avoid double margins). -->
            <Frame x:Name="ContentFrame" Margin="8,8,8,8" />
        </NavigationView>
    </Grid>
</Window>
